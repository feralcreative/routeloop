#!/usr/bin/env bash
################################################################################
# Deployment configuration for routeloop.app
#
# Sourced by utils/deploy/deploy.sh. Committed to the repo — NO SECRETS HERE.
# Secrets (GMAPS_KEY, DB passwords, Cloudflare token) live in .env, gitignored.
################################################################################

# Set by the prod.sh / stage.sh wrappers.
DEPLOY_ENV="${DEPLOY_ENV:-prod}"

PROJECT_NAME="routeloop"

# The app always listens on 6686 *inside* the container; HOST_PORT is what the
# Cloudflare tunnel reaches on the NAS host. The tunnel routes must match these hostnames and ports.
#
# Production — routeloop.app -> localhost:16703; tankbag.app alias -> :6686
PROD_DOMAIN="routeloop.app"
PROD_CONTAINER_NAME="routeloop"
PROD_DB_CONTAINER_NAME="routeloop-db"
PROD_IMAGE_NAME="routeloop:latest"
PROD_HOST_PORT="16703"
PROD_ALIAS_HOST_PORT="6686"

# Staging — stage.routeloop.app -> localhost:6687
STAGE_DOMAIN="stage.routeloop.app"
STAGE_CONTAINER_NAME="routeloop-stage"
STAGE_DB_CONTAINER_NAME="routeloop-stage-db"
STAGE_IMAGE_NAME="routeloop:stage"
STAGE_HOST_PORT="6687"
STAGE_ALIAS_HOST_PORT="16687"

if [ "$DEPLOY_ENV" = "stage" ]; then
  DOMAIN="$STAGE_DOMAIN"
  CONTAINER_NAME="$STAGE_CONTAINER_NAME"
  DB_CONTAINER_NAME="$STAGE_DB_CONTAINER_NAME"
  IMAGE_NAME="$STAGE_IMAGE_NAME"
  HOST_PORT="$STAGE_HOST_PORT"
  ALIAS_HOST_PORT="$STAGE_ALIAS_HOST_PORT"
else
  DOMAIN="$PROD_DOMAIN"
  CONTAINER_NAME="$PROD_CONTAINER_NAME"
  DB_CONTAINER_NAME="$PROD_DB_CONTAINER_NAME"
  IMAGE_NAME="$PROD_IMAGE_NAME"
  HOST_PORT="$PROD_HOST_PORT"
  ALIAS_HOST_PORT="$PROD_ALIAS_HOST_PORT"
fi

# NAS configuration (frozen across all projects).
NAS_USER="ziad"
NAS_HOST="nas.feralcreative.co"
NAS_SSH_PORT="${NAS_SSH_PORT:-33725}"
NAS_DEPLOY_BASE="/volume1/web"
NAS_DEPLOY_PATH="${NAS_DEPLOY_BASE}/${DOMAIN}"

# Built on Apple Silicon, run on the NAS's x86_64.
DOCKER_PLATFORM="linux/amd64"

# The app container runs as this host uid:gid, not the image's node (1000).
# ./data/storage sits on a Synology share whose ACL grants rwx to ziad(1026) and
# r-x to users(100) but nothing to uid 1000, and synoacltool refuses to add an
# entry for a numeric uid with no passwd record. Matching the host owner is the
# only way the container can read — and, from Phase 3, write — user files.
APP_UID="1026"
APP_GID="100"

# The compose file shipped to the NAS as docker-compose.yml. The repo's root
# docker-compose.yml is local-dev-only (Postgres alone), so it is NOT the one
# that gets deployed.
COMPOSE_SRC="docker-compose.prod.yml"

# Applies the Drizzle schema inside the freshly started container.
POST_DEPLOY_HOOK="utils/deploy/hooks/post-deploy.sh"
