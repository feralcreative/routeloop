#!/usr/bin/env bash
################################################################################
# Deployment configuration for routeloop.app
#
# Sourced by utils/deploy/deploy.sh. Committed to the repo — NO SECRETS HERE.
# Secrets (GMAPS_KEY, DB passwords, Cloudflare token) live in .env, gitignored.
################################################################################

# Set by the prod.sh / stage.sh wrappers.
DEPLOY_ENV="${DEPLOY_ENV:-prod}"

PROJECT_NAME="routeloop"

# The app always listens on 6686 *inside* the container; HOST_PORT is what the
# Cloudflare tunnel reaches on the NAS host. The tunnel routes must match these hostnames and ports.
#
# The canonical host went to routeloop.app on 2026-08-11, so HOST_PORT and
# ALIAS_HOST_PORT swapped back with it: the tunnel routes have never moved
# through any of these renames, and each hostname still reaches the port it
# always did. The container publishes both ports and 301s the alias hostname to
# the canonical one, so both keep answering.
#
# Read the port pair as "which hostname is canonical", not "which port is prod".
# routeloop.app has always been the :16703 route and tankbag.app the :6686 one.
#
# Production — routeloop.app -> localhost:16703; tankbag.app alias -> :6686
PROD_DOMAIN="routeloop.app"
# THE PRE-BLUE/GREEN CONTAINER NAME. Nothing in the compose file references it
# any more — the app is app-blue/app-green now. It is kept because the one-time
# cutover runbook has to stop and remove this exact container by name, and
# because it is an orphan of the compose project by definition: a
# `--remove-orphans` anywhere near this directory would take it, which is why
# that flag is banned in docs/deployment.md rather than merely discouraged.
PROD_CONTAINER_NAME="routeloop"
PROD_DB_CONTAINER_NAME="routeloop-db"
PROD_IMAGE_NAME="routeloop:latest"
PROD_HOST_PORT="16703"
PROD_ALIAS_HOST_PORT="6686"

# Staging — stage.routeloop.app -> localhost:6687; stage.tankbag.app -> :16687
STAGE_DOMAIN="stage.routeloop.app"
STAGE_CONTAINER_NAME="routeloop-stage"
STAGE_DB_CONTAINER_NAME="routeloop-stage-db"
STAGE_IMAGE_NAME="routeloop:stage"
STAGE_HOST_PORT="6687"
STAGE_ALIAS_HOST_PORT="16687"

# --- Blue/green --------------------------------------------------------------
#
# The two app containers and the proxy in front of them. The colors publish no
# host ports; the proxy owns both, and proxy/upstream.caddy on the NAS is the
# one line that says which color it is pointed at.
PROD_BLUE_CONTAINER_NAME="routeloop-blue"
PROD_GREEN_CONTAINER_NAME="routeloop-green"
PROD_PROXY_CONTAINER_NAME="routeloop-proxy"
STAGE_BLUE_CONTAINER_NAME="routeloop-stage-blue"
STAGE_GREEN_CONTAINER_NAME="routeloop-stage-green"
STAGE_PROXY_CONTAINER_NAME="routeloop-stage-proxy"

# Pinned rather than floating. A proxy image that moved under us during a
# cutover would be a variable nobody changed causing an outage nobody expected.
PROXY_IMAGE="caddy:2.8-alpine"

# HARD-PINNED PER ENVIRONMENT, not derived from COMPOSE_PROJECT_NAME. Ziad's
# call, 2026-08-27. The parameterized form reads tidier and pins nothing: it
# derives the volume name from the value most likely to be wrong, so a typo in
# the project name produces a confident, wrong, EMPTY volume. These are the
# names the running volumes actually have, verified on the NAS 2026-08-27.
PROD_DB_VOLUME_NAME="routeloop-prod_db-data"
STAGE_DB_VOLUME_NAME="routeloop-stage_db-data"


if [ "$DEPLOY_ENV" = "stage" ]; then
  DOMAIN="$STAGE_DOMAIN"
  CONTAINER_NAME="$STAGE_CONTAINER_NAME"
  DB_CONTAINER_NAME="$STAGE_DB_CONTAINER_NAME"
  IMAGE_NAME="$STAGE_IMAGE_NAME"
  HOST_PORT="$STAGE_HOST_PORT"
  ALIAS_HOST_PORT="$STAGE_ALIAS_HOST_PORT"
  BLUE_CONTAINER_NAME="$STAGE_BLUE_CONTAINER_NAME"
  GREEN_CONTAINER_NAME="$STAGE_GREEN_CONTAINER_NAME"
  PROXY_CONTAINER_NAME="$STAGE_PROXY_CONTAINER_NAME"
  DB_VOLUME_NAME="$STAGE_DB_VOLUME_NAME"
else
  DOMAIN="$PROD_DOMAIN"
  CONTAINER_NAME="$PROD_CONTAINER_NAME"
  DB_CONTAINER_NAME="$PROD_DB_CONTAINER_NAME"
  IMAGE_NAME="$PROD_IMAGE_NAME"
  HOST_PORT="$PROD_HOST_PORT"
  ALIAS_HOST_PORT="$PROD_ALIAS_HOST_PORT"
  BLUE_CONTAINER_NAME="$PROD_BLUE_CONTAINER_NAME"
  GREEN_CONTAINER_NAME="$PROD_GREEN_CONTAINER_NAME"
  PROXY_CONTAINER_NAME="$PROD_PROXY_CONTAINER_NAME"
  DB_VOLUME_NAME="$PROD_DB_VOLUME_NAME"
fi

# NAS configuration (frozen across all projects).
NAS_USER="ziad"
NAS_HOST="nas.feralcreative.co"
NAS_SSH_PORT="${NAS_SSH_PORT:-33725}"
NAS_DEPLOY_BASE="/volume1/web"
# WARNING — this path is derived from $DOMAIN, which changed with the rename to
# routeloop.app on 2026-08-11. Deploying without first moving the directory on
# the NAS creates a brand-new empty stack at /volume1/web/routeloop.app and
# orphans the live one at /volume1/web/tankbag.app, taking ./data/storage with
# it — and the deploy still reports green, because the origin curl is only a
# warning and the container-name check passes against an empty database.
#
# The db-data volume does NOT follow a plain mv either, but not for the reason
# this comment used to give: Compose stopped deriving its project name from this
# directory once deploy.sh started pinning COMPOSE_PROJECT_NAME. The volume is
# namespaced by $PROJECT_NAME, which changed too, so it needs migrating
# explicitly. See the cutover procedure in docs/deployment.md.
NAS_DEPLOY_PATH="${NAS_DEPLOY_BASE}/${DOMAIN}"

# Built on Apple Silicon, run on the NAS's x86_64.
DOCKER_PLATFORM="linux/amd64"

# The app container runs as this host uid:gid, not the image's node (1000).
# ./data/storage sits on a Synology share whose ACL grants rwx to ziad(1026) and
# r-x to users(100) but nothing to uid 1000, and synoacltool refuses to add an
# entry for a numeric uid with no passwd record. Matching the host owner is the
# only way the container can read — and, from Phase 3, write — user files.
APP_UID="1026"
APP_GID="100"

# The compose file shipped to the NAS as docker-compose.yml. The repo's root
# docker-compose.yml is local-dev-only (Postgres alone), so it is NOT the one
# that gets deployed.
COMPOSE_SRC="docker-compose.prod.yml"

# NO POST_DEPLOY_HOOK. Migrations used to run here, via
# utils/deploy/hooks/post-deploy.sh, and the problem was not the hook but WHEN
# it ran: after the new container was already serving, so a deploy carrying a
# migration served new code against the old schema for as long as the step took.
# It is a one-shot `migrate` service now, run by deploy.sh before the app is
# recreated. See docs/zero-downtime-deploy.md.

# How long a container told to stop waits for its in-flight requests, in ms.
# Shipped into the container's environment; see src/shutdown.ts.
DRAIN_GRACE_MS="10000"
