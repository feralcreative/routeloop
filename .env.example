# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Local development ------------------------------------------------------
PORT=6686
GMAPS_KEY=
STORAGE_PATH=./moto-storage
DATABASE_URL=postgresql://tankbag:tankbag_dev_pw@127.0.0.1:5432/tankbag

# --- Auth (Phase 2) ---------------------------------------------------------
# APP_ORIGIN is the public origin of THIS environment. It builds the OAuth
# redirect URIs and decides whether session cookies get the Secure flag, so an
# https value here is required in stage and prod.
#   dev   http://127.0.0.1:6686
#   stage https://stage.tankbag.app
#   prod  https://tankbag.app
APP_ORIGIN=http://127.0.0.1:6686

# Google: one OAuth 2.0 Web Application client can hold every environment's
# redirect URI — add all three as authorized redirect URIs:
#   http://127.0.0.1:6686/auth/google/callback
#   https://stage.tankbag.app/auth/google/callback
#   https://tankbag.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: an OAuth App exposes a single Authorization callback URL, so each
# environment likely needs its own app. Callback: <APP_ORIGIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Either provider may be left blank — the sign-in page offers only the ones that
# are configured, and the rest of the app keeps serving.

# --- Deploy: NAS database passwords -----------------------------------------
# Required by utils/deploy/deploy.sh for the matching environment.
#
# NOTE: Postgres only reads this when it initialises its data volume on the
# FIRST deploy. Changing it later does not change the database password — you
# must ALTER USER inside the running db container (or drop the volume).
#
# Use alphanumerics only: the value is interpolated into a postgresql:// URL,
# so characters like @ : / # would corrupt the connection string.
PROD_DB_PASSWORD=
STAGE_DB_PASSWORD=

# --- Deploy: Cloudflare cache purge (optional but recommended) ---------------
# Token needs Zone.Cache Purge on the tankbag.app zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- Deploy: SSH ------------------------------------------------------------
# Optional override; default auto-detects ~/.ssh/id_ed25519, then id_rsa, then
# ssh-agent (1Password).
# SSH_KEY_PATH=
