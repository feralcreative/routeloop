# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Local development ------------------------------------------------------
PORT=6686
STORAGE_PATH=./moto-storage
DATABASE_URL=postgresql://routeloop:routeloop_dev_pw@127.0.0.1:5432/routeloop

# Mapbox public token — powers the ride builder and native viewer (GL JS,
# Directions, Geocoding). Default public scopes are enough. In DEV, leave URL
# restrictions empty or set them to `localhost` (Mapbox rejects IP addresses),
# and browse at http://localhost:6686 — tiles/Directions 403 from 127.0.0.1.
# In prod/stage, restrict the token to routeloop.app / stage.routeloop.app.
MAPBOX_TOKEN=

# Legacy Google Maps key — used ONLY by the viewer for IMPORTED rides, and only
# until the Mapbox viewer is unified (Phase 4), after which this is removed.
# Referrer-restricted to 127.0.0.1 in dev, routeloop.app in prod.
GMAPS_KEY=

# --- Alpha splash -----------------------------------------------------------
# Links in the "this is an alpha" modal. These are public URLs, not secrets, and
# src/config.ts already defaults them to the live values — set them here only to
# override. An empty value omits that one link rather than rendering a dead one.
# ALPHA_GITHUB_URL=https://github.com/feralcreative/routeloop/issues
# ALPHA_SIGNAL_URL=https://feral.ly/signal
# ALPHA_DISCORD_URL=https://discord.gg/5wqFRxqzxN

# --- Auth -------------------------------------------------------------------
# APP_ORIGIN decides whether session cookies get the Secure flag, so an https
# value here is required in stage and prod. Cloudflare Access protects
# /auth/cloudflare and injects the authenticated user's verified email.
#   dev   http://127.0.0.1:6686
#   stage https://stage.routeloop.app
#   prod  https://routeloop.app
APP_ORIGIN=http://127.0.0.1:6686

# Local development does not traverse Cloudflare Access. Set this to the email
# of the local user to provision/sign in when /auth/cloudflare is opened. It is
# deliberately ignored whenever APP_ORIGIN starts with https://.
DEV_AUTH_EMAIL=

# --- Deploy: NAS database passwords -----------------------------------------
# Required by utils/deploy/deploy.sh for the matching environment.
#
# NOTE: Postgres only reads this when it initialises its data volume on the
# FIRST deploy. Changing it later does not change the database password — you
# must ALTER USER inside the running db container (or drop the volume).
#
# Use alphanumerics only: the value is interpolated into a postgresql:// URL,
# so characters like @ : / # would corrupt the connection string.
PROD_DB_PASSWORD=
STAGE_DB_PASSWORD=

# --- Deploy: Cloudflare cache purge (optional but recommended) ---------------
# Token needs Zone.Cache Purge on the routeloop.app zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- Deploy: SSH ------------------------------------------------------------
# Optional override; default auto-detects ~/.ssh/id_ed25519, then id_rsa, then
# ssh-agent (1Password).
# SSH_KEY_PATH=
