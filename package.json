{
  "name": "routeloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Multi-tenant motorcycle route map sharing app (TypeScript + Hono).",
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "sass --watch style/main.scss public/style/main.min.css & SASS=$!; trap \"kill $SASS 2>/dev/null\" EXIT INT TERM; tsx watch src/index.tsx",
    "dev:server": "tsx watch src/index.tsx",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx utils/db-baseline.ts",
    "start": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "sass": "sass style/main.scss public/style/main.min.css --style=compressed --no-source-map",
    "sass:watch": "sass --watch style/main.scss public/style/main.min.css",
    "fix:dashes": "node utils/tighten-em-dashes.mjs --write",
    "check:dashes": "node utils/tighten-em-dashes.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@xmldom/xmldom": "^0.9.10",
    "arctic": "^3.7.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "sass": "^1.102.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uplot": "^1.6.32",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
