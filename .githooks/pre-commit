#!/usr/bin/env sh
#
# Tightens spaced em dashes, curls straight quotes and Americanizes British
# spellings in staged prose, then re-stages what changed.
#
# Fixes rather than blocks: the correction is mechanical and unambiguous, so
# stopping the commit to make someone retype a dash is friction for no gain.
# A line that genuinely wants air around its dash should use an en dash, which
# the script leaves alone.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(md|ts|tsx|js|mjs|html)$')
[ -z "$staged" ] && exit 0

# shellcheck disable=SC2086
node utils/tighten-em-dashes.mjs --write $staged || exit 0
# Contractions in visible copy. Each tool ignores the extensions it does not
# own, so both get the same list rather than two filtered ones that can drift.
# shellcheck disable=SC2086
node utils/smart-quotes.mjs --write $staged || exit 0

# American English. THE HOOK FIXES AND `test/us-english.test.ts` REFUSES, which
# is deliberate belt and braces: this rule had been written down in AGENTS.md
# for months and the tree still carried ~110 British spellings, because nothing
# ran. A hook is per-clone and skippable; the test runs in CI.
# shellcheck disable=SC2086
node utils/us-english.mjs --write $staged || exit 0

# Only re-stage files that were already staged and that the script actually
# changed — never sweep up unrelated edits sitting in the working tree.
for f in $staged; do
  if [ -f "$f" ] && ! git diff --quiet -- "$f"; then
    git add -- "$f"
  fi
done
exit 0
